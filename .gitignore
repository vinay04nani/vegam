# Vegam: files Git should never track. Patterns without a leading slash
# apply in every folder (frontend/, and the planned apps/ and packages/).

# ---- Dependencies ----
node_modules/
.pnpm-store/
.yarn/
.npm/
jspm_packages/

# ---- Build output ----
.next/
out/
dist/
build/
.turbo/
.vercel/
.netlify/
storybook-static/
*.tsbuildinfo
next-env.d.ts

# ---- Tests and coverage ----
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
/playwright/.cache/

# ---- Environment and secrets (never commit real keys) ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.secrets/
service-account*.json

# ---- Supabase local development ----
supabase/.branches/
supabase/.temp/
supabase/.env

# ---- Logs and debug ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# ---- Caches ----
.cache/
.eslintcache
.stylelintcache
*.cache

# ---- Docker (local overrides) ----
docker-compose.override.yml
.docker/

# ---- Editors and IDEs ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
*.sublime-workspace

# ---- Operating systems ----
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---- Local scratch ----
tmp/
temp/
*.local
